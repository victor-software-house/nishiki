        = x
      - if a ||
        b
    = form_for @x do |f|
    ~ code
    != raw
    &= escaped
    &amp= amp
    !== #{unescaped} \t
    - foo elseif(a) foreach (b) switch(c) declare(d) default(e) use (f)
