{
  "IffalseBlock": {
    "role": "begin",
    "regex": "(?<=^\\s*)((\\\\)iffalse)(?!\\s*[{}]\\s*\\\\fi\\b)"
  },
  "IffalseBlockEnd": {
    "role": "end",
    "regex": "((\\\\)(?:else|fi))\\b"
  },
  "Comment": {
    "role": "begin",
    "regex": "(^[\\t ]+)?(?=%)"
  },
  "CommentEnd": {
    "role": "end",
    "regex": "(?!\\G)"
  },
  "CommentAt0": {
    "role": "begin",
    "regex": "%:?"
  },
  "CommentAt0End": {
    "role": "end",
    "regex": "$\\n?"
  },
  "CommentAt1": {
    "role": "begin",
    "regex": "^(%!TEX) (\\S*) ="
  },
  "CommentAt1End": {
    "role": "end",
    "regex": "$\\n?"
  },
  "Braces": {
    "role": "begin",
    "regex": "(?<!\\\\)\\{"
  },
  "BracesEnd": {
    "role": "end",
    "regex": "(?<!\\\\)}"
  },
  "Conditionals": {
    "role": "begin",
    "regex": "(?<=^\\s*)\\\\if(?!f\\b)[a-z]*"
  },
  "ConditionalsEnd": {
    "role": "end",
    "regex": "(?<=^\\s*)\\\\fi"
  },
  "MacroControl": {
    "role": "match",
    "regex": "(\\\\)(backmatter|csname|else|endcsname|fi|frontmatter|mainmatter|unless|if(case|cat|csname|defined|dim|eof|false|fontchar|hbox|hmode|inner|mmode|num|odd|true|vbox|vmode|void|x)?)(?![@-Za-z])"
  },
  "Catcode": {
    "role": "match",
    "regex": "((\\\\)catcode)`\\\\?.(=)(\\d+)"
  },
  "RootAt4": {
    "role": "match",
    "regex": "[]\\[]"
  },
  "DollarMath": {
    "role": "begin",
    "regex": "(\\$\\$?)"
  },
  "DollarMathEnd": {
    "role": "end",
    "regex": "(\\1)"
  },
  "DollarMathAt0": {
    "role": "match",
    "regex": "\\\\\\$"
  },
  "MathContentAt0": {
    "role": "begin",
    "regex": "((\\\\)(?:text|mbox))(\\{)"
  },
  "MathContentAt0End": {
    "role": "end",
    "regex": "}"
  },
  "RootAt6": {
    "role": "match",
    "regex": "\\\\\\\\"
  },
  "Ifnextchar": {
    "role": "match",
    "regex": "\\\\@ifnextchar[(\\[{]"
  },
  "MacroGeneralAt0": {
    "role": "match",
    "regex": "(\\\\)_*[@\\p{Alphabetic}]+(?:_[@\\p{Alphabetic}]+)*:[DFNTVcefnopvwx]*"
  },
  "MacroGeneralAt1": {
    "role": "match",
    "regex": "(\\.)[@\\p{Alphabetic}]+(?:_[@\\p{Alphabetic}]+)*:[DFNTVcefnopvwx]*"
  },
  "MacroGeneralAt2": {
    "role": "match",
    "regex": "(\\\\)(?:[,;]|[@\\p{Alphabetic}]+)"
  },
  "MacroGeneralAt3": {
    "role": "match",
    "regex": "(\\\\)[^@-Za-z]"
  },
  "MathContentAt1": {
    "role": "match",
    "regex": "\\\\[{}]"
  },
