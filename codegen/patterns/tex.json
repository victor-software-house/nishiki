  },
  "MathContentAt4": {
    "role": "match",
    "regex": "(\\\\)(sum|prod|coprod|int|oint|bigcap|bigcup|bigsqcup|bigvee|bigwedge|bigodot|bigotimes|bogoplus|biguplus)\\b"
  },
  "MathContentAt5": {
    "role": "match",
    "regex": "(\\\\)(arccos|arcsin|arctan|arg|cosh??|coth??|csc|deg|det|dim|exp|gcd|hom|inf|ker|lg|lim|liminf|limsup|ln|log|max|min|pr|sec|sinh??|sup|tanh??)\\b"
  },
  "MathContentAt6": {
    "role": "begin",
    "regex": "((\\\\)Sexpr(\\{))"
  },
  "MathContentAt6End": {
    "role": "end",
    "regex": "(((})))"
  },
  "MathContentAt6At0": {
    "role": "begin",
    "regex": "\\G(?!})"
  },
  "MathContentAt6At0End": {
    "role": "end",
    "regex": "(?=})"
  },
  "MathContentAt7": {
    "role": "match",
    "regex": "(\\\\)(?!begin\\{|verb)([A-Za-z]+)"
  },
  "MathContentAt8": {
    "role": "match",
    "regex": "(?<!\\\\)\\{"
  },
  "MathContentAt9": {
    "role": "match",
    "regex": "(?<!\\\\)}"
  },
  "MathContentAt10": {
    "role": "match",
    "regex": "(?<!\\\\)\\("
  },
  "MathContentAt11": {
    "role": "match",
    "regex": "(?<!\\\\)\\)"
  },
  "MathContentAt12": {
    "role": "match",
    "regex": "(([0-9]*\\.[0-9]+)|[0-9]+)"
  },
  "MathContentAt13": {
    "role": "match",
    "regex": "[-*+/]|(?<!\\^)\\^(?!\\^)|(?<!_)_(?!_)"
