{
  "RootAt0": {
    "role": "begin",
    "regex": "/\\*"
  },
  "RootAt0End": {
    "role": "end",
    "regex": "\\*/"
  },
  "CommentTag": {
    "role": "begin",
    "regex": "\\{\\{"
  },
  "CommentTagEnd": {
    "role": "end",
    "regex": "}}"
  },
  "CommentTagAt0": {
    "role": "match",
    "regex": "[-\\w]+"
  },
  "DoubleSlash": {
    "role": "begin",
    "regex": "//"
  },
  "DoubleSlashEnd": {
    "role": "end",
    "regex": "$"
  },
  "DoubleQuoted": {
    "role": "begin",
    "regex": "\""
  },
  "DoubleQuotedEnd": {
    "role": "end",
    "regex": "\""
  },
  "QuotedInterpolation": {
    "role": "begin",
    "regex": "#\\{"
  },
  "QuotedInterpolationEnd": {
    "role": "end",
    "regex": "}"
  },
  "Variable": {
    "role": "match",
    "regex": "\\$[-\\w]+"
  },
  "Numeric": {
    "role": "match",
    "regex": "([-.])?[0-9]+(\\.[0-9]+)?"
  },
  "Operator": {
    "role": "match",
    "regex": "\\+|\\s-\\s|\\s-(?=\\$)|(?<=\\()-(?=\\$)|\\s-(?=\\()|[!%*/<=>~]"
  },
  "Unit": {
    "role": "match",
    "regex": "(?<=[}\\d])(ch|cm|deg|dpcm|dpi|dppx|em|ex|grad|Hz|in|kHz|mm|ms|pc|pt|px|rad|rem|s|turn|vh|vmax|vmin|vw|%)"
  },
  "SingleQuoted": {
    "role": "begin",
    "regex": "'"
  },
  "SingleQuotedEnd": {
    "role": "end",
    "regex": "'"
  },
  "Interpolation": {
    "role": "begin",
    "regex": "#\\{"
  },
  "InterpolationEnd": {
    "role": "end",
    "regex": "}"
  },
  "PlaceholderSelector": {
    "role": "begin",
    "regex": "(?<!\\d)%(?!\\d)"
  },
  "PlaceholderSelectorEnd": {
    "role": "end",
    "regex": "$\\n?|\\s|(?=[;{])"
  },
  "VariableRootCss": {
    "role": "match",
    "regex": "(?<!&)--[-\\w]+"
  },
  "Flag": {
    "role": "match",
    "regex": "!(important|default|optional|global)"
  },
  "Dotdotdot": {
    "role": "match",
    "regex": "\\.{3}"
  },
  "RootAt12": {
    "role": "begin",
    "regex": "@include"
  },
  "RootAt12End": {
    "role": "end",
    "regex": "(?=[\\n(;{])"
  },
  "RootAt13": {
    "role": "begin",
    "regex": "@(?:mixin|function)"
  },
  "RootAt13End": {
    "role": "end",
    "regex": "$\\n?|(?=[({])"
  },
  "RootAt13At0": {
    "role": "match",
    "regex": "[-\\w]+"
  },
  "RootAt14": {
    "role": "match",
    "regex": "(?<=@import)\\s[-*./\\w]+"
  },
  "RootAt15": {
    "role": "begin",
    "regex": "@"
  },
  "RootAt15End": {
    "role": "end",
    "regex": "$\\n?|\\s(?!(all|braille|embossed|handheld|print|projection|screen|speech|tty|tv|if|only|not)([,\\s]))|(?=;)"
  },
  "RootAt16": {
    "role": "begin",
    "regex": "#"
  },
  "RootAt16End": {
    "role": "end",
    "regex": "$\\n?|(?=[(),.;>\\[{\\s])"
  },
  "PseudoClass": {
    "role": "match",
    "regex": ":[-:a-z]+"
  },
  "RootAt17": {
    "role": "begin",
    "regex": "\\.|(?<=&)([-_])"
  },
  "RootAt17End": {
    "role": "end",
    "regex": "$\\n?|(?=[(),;>\\[{\\s])"
  },
  "RootAt18": {
    "role": "begin",
    "regex": "\\["
  },
  "RootAt18End": {
    "role": "end",
    "regex": "]"
  },
  "RootAt18At2": {
    "role": "match",
    "regex": "[$*^~]"
  },
  "RootAt19": {
    "role": "match",
    "regex": "(?<=[])]|not\\(|[*>]|>\\s):[-:a-z]+|(:[-:])[-:a-z]+"
  },
  "RootAt20": {
    "role": "begin",
    "regex": ":"
  },
  "RootAt20End": {
    "role": "end",
    "regex": "$\\n?|(?=;|\\s\\(|and\\(|[{}]|\\),)"
  },
  "RgbValue": {
    "role": "match",
    "regex": "(#)(\\h{3}|\\h{6})\\b"
  },
  "Function": {
    "role": "match",
    "regex": "(?<=[(,:|\\s])(?!url|format|attr)[-\\w][-\\w]*(?=\\()"
  },
  "FunctionContent": {
    "role": "match",
    "regex": "(?<=url\\(|format\\(|attr\\().+?(?=\\))"
  },
  "FunctionContentVar": {
    "role": "match",
    "regex": "(?<=var\\()[-\\w]+(?=\\))"
  },
  "ParentSelector": {
    "role": "match",
    "regex": "&"
  },
  "PropertyValue": {
    "role": "match",
    "regex": "[-\\w]+"
  },
  "RootAt24": {
    "role": "begin",
    "regex": "(?<![-(])\\b(a|abbr|acronym|address|applet|area|article|aside|audio|b|base|big|blockquote|body|br|button|canvas|caption|cite|code|col|colgroup|datalist|dd|del|details|dfn|dialog|div|dl|dt|em|embed|eventsource|fieldset|figure|figcaption|footer|form|frame|frameset|(h[1-6])|head|header|hgroup|hr|html|i|iframe|img|input|ins|kbd|label|legend|li|link|map|mark|menu|meta|meter|nav|noframes|noscript|object|ol|optgroup|option|output|p|param|picture|pre|progress|q|samp|script|section|select|small|source|span|strike|strong|style|sub|summary|sup|table|tbody|td|textarea|tfoot|th|thead|time|title|tr|tt|ul|var|video|main|svg|rect|ruby|center|circle|ellipse|line|polyline|polygon|path|text|[ux])\\b(?![-)]|:\\s)|&"
  },
  "RootAt24End": {
    "role": "end",
    "regex": "(?=[-(),.;>\\[_{\\s])"
  },
  "RootAt26": {
    "role": "match",
    "regex": "[-a-z]+((?=:|#\\{))"
  },
  "ReservedWords": {
    "role": "match",
    "regex": "\\b(false|from|in|not|null|through|to|true)\\b"
  }
}
