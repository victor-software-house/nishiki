{
  "RootAt0": {
    "role": "begin",
    "regex": "^(\\s*)(/\\*)"
  },
  "RootAt0End": {
    "role": "end",
    "regex": "(\\*/)|^(?!\\s\\1)"
  },
  "CommentTag": {
    "role": "begin",
    "regex": "(?<=\\{\\{)"
  },
  "CommentTagEnd": {
    "role": "end",
    "regex": "(?=}})"
  },
  "CommentParam": {
    "role": "match",
    "regex": "@(\\w+)"
  },
  "RootAt1": {
    "role": "match",
    "regex": "^[\\t ]*/?//[\\t ]*[IRS][\\t ]*$"
  },
  "RootAt2": {
    "role": "begin",
    "regex": "^[\\t ]*//[\\t ]*(import)[\\t ]*(css-variables)[\\t ]*(from)"
  },
  "RootAt2End": {
    "role": "end",
    "regex": "$\\n?"
  },
  "ImportQuotes": {
    "role": "match",
    "regex": "[\"']?\\.{0,2}[/\\w]+[\"']?"
  },
  "DoubleSlash": {
    "role": "begin",
    "regex": "//"
  },
  "DoubleSlashEnd": {
    "role": "end",
    "regex": "$\\n?"
  },
  "DoubleQuoted": {
    "role": "begin",
    "regex": "\""
  },
  "DoubleQuotedEnd": {
    "role": "end",
    "regex": "\""
  },
  "QuotedInterpolation": {
    "role": "begin",
    "regex": "#\\{"
  },
  "QuotedInterpolationEnd": {
    "role": "end",
    "regex": "}"
  },
  "Variable": {
    "role": "match",
    "regex": "\\$[-0-9A-Z_a-z]+"
  },
  "Numeric": {
    "role": "match",
    "regex": "([-.])?[0-9]+(\\.[0-9]+)?"
  },
  "Operator": {
    "role": "match",
    "regex": "\\+|\\s-\\s|\\s-(?=\\$)|(?<=\\()-(?=\\$)|\\s-(?=\\()|[!%*/<=>~]"
  },
  "Unit": {
    "role": "match",
    "regex": "(?<=[}\\d])(ch|cm|deg|dpcm|dpi|dppx|em|ex|grad|Hz|in|kHz|mm|ms|pc|pt|px|rad|rem|s|turn|vh|vmax|vmin|vw|fr|%)"
  },
  "Comma": {
    "role": "match",
    "regex": "\\band\\b|\\bor\\b|,"
  },
  "SingleQuoted": {
    "role": "begin",
    "regex": "'"
  },
  "SingleQuotedEnd": {
    "role": "end",
    "regex": "'"
  },
  "Interpolation": {
    "role": "begin",
    "regex": "#\\{"
  },
  "InterpolationEnd": {
    "role": "end",
    "regex": "}"
  },
  "CurlyBrackets": {
    "role": "match",
    "regex": "[{}]"
  },
  "PlaceholderSelector": {
    "role": "begin",
    "regex": "(?<!\\d)%(?!\\d)"
  },
  "PlaceholderSelectorEnd": {
    "role": "end",
    "regex": "$\\n?|\\s"
  },
  "RootAt9": {
    "role": "begin",
    "regex": "\\$[-0-9A-Z_a-z]+(?=:)"
  },
  "RootAt9End": {
    "role": "end",
    "regex": "$\\n?|(?=\\)(?:\\s\\)|\\n))"
  },
  "RgbValue": {
    "role": "match",
    "regex": "(#)(\\h{3,4}|\\h{6}|\\h{8})\\b"
  },
  "Flag": {
    "role": "match",
    "regex": "!(important|default|optional|global)"
  },
  "Function": {
    "role": "match",
    "regex": "(?<=[(,:|\\s])(?!url|format|attr)[-0-9A-Z_a-z][-\\w]*(?=\\()"
  },
  "FunctionContent": {
    "role": "begin",
    "regex": "(?<=url\\(|format\\(|attr\\()"
  },
  "FunctionContentEnd": {
    "role": "end",
    "regex": ".(?=\\))"
  },
  "ReservedWords": {
    "role": "match",
    "regex": "\\b(false|from|in|not|null|through|to|true)\\b"
  },
  "ParentSelector": {
    "role": "match",
    "regex": "&"
  },
  "PropertyValue": {
    "role": "match",
    "regex": "[-0-9A-Z_a-z]+"
  },
  "Semicolon": {
    "role": "match",
    "regex": ";"
  },
  "Dotdotdot": {
    "role": "match",
    "regex": "\\.\\.\\."
  },
  "VariableRoot": {
    "role": "match",
    "regex": "\\$[-0-9A-Z_a-z]+"
  },
  "RootAt17": {
    "role": "begin",
    "regex": "@include|\\+(?![\\W\\d])"
  },
  "RootAt17End": {
    "role": "end",
    "regex": "(?=[\\n(])"
  },
  "RootAt18": {
    "role": "begin",
    "regex": "^(@use)"
  },
  "RootAt18End": {
    "role": "end",
    "regex": "(?=\\n)"
  },
  "RootAt18At0": {
    "role": "match",
    "regex": "as|with"
  },
  "ParenthesisOpen": {
    "role": "match",
    "regex": "\\("
  },
  "ParenthesisClose": {
    "role": "match",
    "regex": "\\)"
  },
  "Colon": {
    "role": "match",
    "regex": ":"
  },
  "RootAt19": {
    "role": "begin",
    "regex": "^@import(.*?)( as.*)?$"
  },
  "RootAt19End": {
    "role": "end",
    "regex": "(?=\\n)"
  },
  "RootAt20": {
    "role": "begin",
    "regex": "@mixin|^[\\t ]*=|@function"
  },
  "RootAt20End": {
    "role": "end",
    "regex": "$\\n?|(?=\\()"
  },
  "RootAt20At0": {
    "role": "match",
    "regex": "[-\\w]+"
  },
  "RootAt21": {
    "role": "begin",
    "regex": "@"
  },
  "RootAt21End": {
    "role": "end",
    "regex": "$\\n?|\\s(?!(all|braille|embossed|handheld|print|projection|screen|speech|tty|tv|if|only|not)([,\\s]))"
  },
  "RootAt22": {
    "role": "begin",
    "regex": "(?<![-(])\\b(a|abbr|acronym|address|applet|area|article|aside|audio|b|base|big|blockquote|body|br|button|canvas|caption|cite|code|col|colgroup|datalist|dd|del|details|dfn|dialog|div|dl|dt|em|embed|eventsource|fieldset|figure|figcaption|footer|form|frame|frameset|(h[1-6])|head|header|hgroup|hr|html|i|iframe|img|input|ins|kbd|label|legend|li|link|map|mark|menu|meta|meter|nav|noframes|noscript|object|ol|optgroup|option|output|p|param|picture|pre|progress|q|samp|script|section|select|small|source|span|strike|strong|style|sub|summary|sup|table|tbody|td|textarea|tfoot|th|thead|time|title|tr|tt|ul|var|video|main|svg|rect|ruby|center|circle|ellipse|line|polyline|polygon|path|text|u|slot)\\b(?![-)]|:\\s)|&"
  },
  "RootAt22End": {
    "role": "end",
    "regex": "$\\n?|(?=[-#(),.>\\[_\\s])"
  },
  "PseudoClass": {
    "role": "match",
    "regex": ":[-:a-z]+"
  },
  "RootAt23": {
    "role": "begin",
    "regex": "#"
  },
  "RootAt23End": {
    "role": "end",
    "regex": "$\\n?|(?=[(),.>\\[\\s])"
  },
  "RootAt24": {
    "role": "begin",
    "regex": "\\.|(?<=&)([-_])"
  },
  "RootAt24End": {
    "role": "end",
    "regex": "$\\n?|(?=[(),>\\[\\s])"
  },
  "RootAt25": {
    "role": "begin",
    "regex": "\\["
  },
  "RootAt25End": {
    "role": "end",
    "regex": "]"
  },
  "RootAt25At2": {
    "role": "match",
    "regex": "[$*^~]"
  },
  "RootAt26": {
    "role": "match",
    "regex": "^((?<=[])]|not\\(|[*>]|>\\s)|\\n*):[-:a-z]+|(:[-:])[-:a-z]+"
  },
  "Module": {
    "role": "match",
    "regex": "([-\\w]+?)(\\.)"
  },
  "RootAt28": {
    "role": "match",
    "regex": "[-\\w]*\\("
  },
  "RootAt29": {
    "role": "match",
    "regex": "\\)"
  },
  "RootAt30": {
    "role": "begin",
    "regex": ":"
  },
  "RootAt30End": {
    "role": "end",
    "regex": "$\\n?|(?=\\s\\(|and\\(|\\),)"
  },
  "RootAt30At0": {
    "role": "match",
    "regex": "(?<=:)[-a-z]+\\s"
  },
  "RootAt30At11": {
    "role": "match",
    "regex": "--.+?(?=\\))"
  },
  "RootAt30At12": {
    "role": "match",
    "regex": "[-\\w]*\\("
  },
  "RootAt30At13": {
    "role": "match",
    "regex": "\\)"
  },
  "RootAt34": {
    "role": "begin",
    "regex": "(?<=})(?![\\n()]|[-0-9A-Z_a-z]+:)"
  },
  "RootAt34End": {
    "role": "end",
    "regex": "\\s|(?=[\\n),.\\[])"
  },
  "RootAt36": {
    "role": "match",
    "regex": "[-a-z]+((?=:|#\\{))"
  }
}
