  },
  "SliceInclusive": {
    "role": "match",
    "regex": "(?<!\\.)\\.{2}"
  },
  "Paren": {
    "role": "begin",
    "regex": "\\("
  },
  "ParenEnd": {
    "role": "end",
    "regex": "\\)"
  },
  "InstanceVariable": {
    "role": "match",
    "regex": "(@)([$A-Z_a-z]\\w*)?"
  },
  "SingleString": {
    "role": "begin",
    "regex": "'"
  },
  "SingleStringEnd": {
    "role": "end",
    "regex": "'"
  },
  "SingleEscape": {
    "role": "match",
    "regex": "(\\\\)(x\\h{2}|[012][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.)"
  },
  "DestructuredArrayName": {
    "role": "match",
    "regex": "[$A-Z_a-z]\\w*"
  },
  "DestructuredObjectName": {
    "role": "match",
    "regex": "[$A-Z_a-z]\\w*"
  },
  "JsxExpression": {
    "role": "begin",
    "regex": "\\{"
  },
  "JsxExpressionEnd": {
    "role": "end",
    "regex": "}"
  },
  "SvelteVariable": {
    "role": "match",
    "regex": "(?<![\"$'./_[:alnum:]])\\$(?=[_[:alpha:]][$_[:alnum:]]*)"
  },
  "SvelteProps": {
    "role": "match",
    "regex": "(?<![\"$'./_[:alnum:]])(\\$\\$)(?=props|restProps|slots)"
  }
}
