# The target directory of one build: base-1, head-1, base-16 or head-16.
build_target() {
  case "$1" in
  base-*) echo "$base_target/cgu-${1#base-}" ;;
  head-*) echo "$head_target/cgu-${1#head-}" ;;
  *)
    echo "no build named $1" >&2
    return 1
    ;;
  esac
}

