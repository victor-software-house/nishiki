replace 6093 6093 1261
# What one pass over each language's fixtures allocates, from fresh
# highlighters (examples/memory.rs): exact counts, for information only.
echo
echo "Memory, for information: allocations, then KiB allocated, then the most KiB one document held at once."
echo
echo "| language | allocations, base | allocations, head | KiB, base | KiB, head | peak KiB, base | peak KiB, head |"
echo "|:--|--:|--:|--:|--:|--:|--:|"
for language in "${languages[@]}"; do
  if [ -z "$(ls -A "$fixtures/$language")" ]; then
    echo "| $language | new | | | | | |"
    continue
  fi
  read -r base_allocs base_bytes base_peak < <("$dir/target-base-16/release/examples/memory" "$fixtures" "$language")
  read -r head_allocs head_bytes head_peak < <("$dir/target-head-16/release/examples/memory" "$fixtures" "$language")
  if [ -z "${base_peak:-}" ] || [ -z "${head_peak:-}" ]; then
    echo "examples/memory.rs printed no counts for $language" >&2
    exit 1
  fi
  awk -v l="$language" -v b_n="$base_allocs" -v h_n="$head_allocs" -v b_bytes="$base_bytes" -v h_bytes="$head_bytes" -v b_peak="$base_peak" -v h_peak="$head_peak" 'BEGIN {
    printf "| %s | %d | %d | %.1f | %.1f | %.1f | %.1f |\n", l, b_n, h_n, b_bytes / 1024, h_bytes / 1024, b_peak / 1024, h_peak / 1024
  }'
done

replace 1359 1402 121
# MISE_ENV=dev,bench locally (Linux only); it stops when the valgrind on
# PATH is not the version mise.bench.toml pins.

replace 1940 1940 494
# The counts are compared against runs of the pinned valgrind, so another
# version, or none on PATH because the bench profile is not loaded, stops the
# task here instead of yielding empty or shifted counts.
pin=$(taplo get -f mise.bench.toml 'tools."conda:valgrind"')
found=$(valgrind --version 2>/dev/null || echo none)
if [ "$found" != "valgrind-$pin" ]; then
  echo "valgrind $found is not the pinned $pin (mise.bench.toml); run with MISE_ENV=dev,bench, or ci,bench in CI" >&2
  exit 1
fi

replace 4560 4560 228
# valgrind's output stays in counts/<build>.<language>.log, and a run that
# fails stops the task with its tail: xargs then exits non-zero. The child
# shells run with -euo pipefail, as this one does, which they do not inherit.

replace 4855 5103 404
  local log="$counts/$1.$2.log"
  if ! valgrind --tool=callgrind --callgrind-out-file=/dev/null --collect-atstart=no \
    --toggle-collect='*lex::measured*' "$dir/target-$1/release/examples/lex" "$fixtures" "$2" >"$log" 2>&1; then
    echo "valgrind failed on $1 $2; the end of $log:" >&2
    tail -n 20 "$log" >&2
    return 1
  fi
  sed -n 's/.*Collected : *\([0-9]*\).*/\1/p' "$log" >"$counts/$1.$2"

