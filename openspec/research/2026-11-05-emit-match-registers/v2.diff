+    /// Pushes the text of capture group `group` onto `name`, spelled as
+    /// the grammar spells a name with `prefix`.
+    ///
+    /// This is out of line.
+    /// Inlined with `dynamic_path` into `emit_match`, it raised the register
+    /// pressure of `emit_match`'s hot loop, though CSS builds no name from a
+    /// group: CSS's `emit_match` ran 19,062 more instructions at one codegen
+    /// unit.
+    #[inline(never)]
+    fn push_group_text(&self, name: &mut String, group: u8, prefix: &'static str) {
+        let text = String::from_utf8_lossy(self.cap_text(group.into()));
+        push_spelled(name, &text, G::dyn_name_case(prefix));
+    }
