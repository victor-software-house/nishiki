+    /// Pushes the text of `source` onto `name`, without its leading dots,
+    /// spelled as the grammar spells a name with `prefix`.
+    ///
+    /// This is out of line.
+    /// Inlined with `dynamic_path` into `emit_match`, it raised the register
+    /// pressure of `emit_match`'s hot loop.
+    #[inline(never)]
+    fn push_name_text(&self, name: &mut String, prefix: &'static str, source: NameSource) {
+        match source {
+            NameSource::Line { start, end, case } => {
+                let text = String::from_utf8_lossy(self.s.get(start..end).unwrap_or_default());
+                push_spelled(name, &text, case);
+            }
+            NameSource::Interned(id) => {
+                name.push_str(self.arena.string(id).trim_start_matches('.'));
+            }
+            NameSource::Group(group) => {
+                let text = String::from_utf8_lossy(self.cap_text(group.into()));
+                push_spelled(name, &text, G::dyn_name_case(prefix));
+            }
+        }
+    }
